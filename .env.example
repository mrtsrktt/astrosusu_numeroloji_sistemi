# Derin Numeroloji Sunucu ve Veritabanı Yapılandırması
PORT=8782
DATABASE_URL=postgres://postgres:postgrespassword@127.0.0.1:5432/derin_numeroloji
SESSION_SECRET=yerel-gelistirme-gizli-anahtari-32-karakterli
NODE_ENV=development
PDF_TEST_MODE=false
PDF_TEST_SOURCE=C:\3matolye\numeroloji\rapor-prototipi\Astro-Susu-Yorum-Raporu-v3.pdf
# Private directory, never served by express.static. Production ignores test mode.
PDF_ARCHIVE_DIR=./private-reports
# PDF-only storage backend: local (default) or r2. Existing local reports stay local.
PDF_ARCHIVE_BACKEND=local
# R2: private bucket, public access disabled. Server-only, least-privilege object
# read/write/delete credentials scoped to this bucket; never use client env vars.
# S3-compatible endpoint (no bucket path); region defaults to auto. No public URLs used.
PDF_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
PDF_R2_REGION=auto
PDF_R2_BUCKET=YOUR_PRIVATE_PDF_BUCKET
PDF_R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
PDF_R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# Real generation: turn sample mode off and live mode on. Key stays server-side.
PDF_LIVE_MODE=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Vercel only: one shared deadline for the first model request and its single
# correction (not a fresh timeout per request). 1000–240000 ms; default 240000.
# Set below your deployment's function maxDuration, allowing PDF/archive overhead.
PDF_MODEL_BUDGET_MS=240000
